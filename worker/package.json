{
  "name": "tfl-status",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --test-scheduled",
    "deploy": "wrangler deploy",
    "db:init:local": "wrangler d1 execute tfl-db --local --file=schema.sql",
    "db:init:remote": "wrangler d1 execute tfl-db --remote --file=schema.sql",
    "tail": "wrangler tail",
    "test": "node --test test/*.test.js"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
